# Copy to .env.local for local development. On Netlify, add the same variables in Site settings -> Environment variables.

# Apps Script web app URL (ends with /exec). Leave empty to run in demo mode with sample products.
APPS_SCRIPT_URL=
# Must equal the API_SECRET script property in Apps Script.
APPS_SCRIPT_SECRET=

NEXT_PUBLIC_BRAND_NAME="Bel Air Fragrances"
NEXT_PUBLIC_TAGLINE="Fine fragrances, delivered to your door."
NEXT_PUBLIC_CURRENCY=TND
